# server/.env にコピーして使う（.env はコミットしない）
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# docker compose のDBに接続する場合
DATABASE_URL=postgres://app:app@localhost:5432/schedule_app
# JWT の検証先（dev の値は SSM パラメータ /schedule-app/dev/auth/user-pool-id・web-client-id で確認できる）
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
