# server/.env にコピーして使う（.env はコミットしない）
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# docker compose のDBに接続する場合
DATABASE_URL=postgres://app:app@localhost:5432/schedule_app
# JWT の検証先（dev の値は SSM パラメータ /schedule-app/dev/auth/user-pool-id・web-client-id で確認できる）
COGNITO_USER_POOL_ID=
COGNITO_WEB_CLIENT_ID=
# 準備のみの機能の Feature Flag（既定はすべて OFF。検証で一時的に ON にするときだけ true にする）
# FEATURE_VOICE_INPUT=false
# FEATURE_NOTIFICATION=false
# FEATURE_POSTPONE_REPLAN=false
# FEATURE_DEPARTURE_DETECTION=false
# FEATURE_OPERATION_MONITORING=false
# FEATURE_STAGED_NOTIFICATION=false
# 外部 API のキー（ローカルで実際の API を呼ぶときだけ設定する。AWS では Secrets Manager から入る）
# Google Maps のサーバ用キーは接続元 IP を制限しているため、手元からは呼べない
# GOOGLE_MAPS_SERVER_KEY=
# NAVITIME_RAPIDAPI_KEY=
