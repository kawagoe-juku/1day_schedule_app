Cell id="c277" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c232"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c278" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c240"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c279" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c270"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c280" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c245"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c281" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c254"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c282" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c179" target="c263"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c283" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c194" target="c202"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c284" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c194" target="c217"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c285" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c194" target="c225"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c286" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c194" target="c263"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c287" value="" style="endArrow=ERmany;startArrow=ERmandOne;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;endFill=0;startFill=0;" edge="1" parent="1" source="c245" target="c254"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c288" value='&lt;table style="border-collapse:collapse;width:820px;font-size:11px;"&gt;&lt;colgroup&gt;&lt;col style="width:150px"&gt;&lt;col style="width:300px"&gt;&lt;col style="width:370px"&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;テーブル&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;インデックス（PK以外）&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;制約・備考&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_plan_user_id(user_id)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;status：生成中／確認質問中／完了／エラー。clarification_count ≦ 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan_item&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_plan_item_plan_id_sequence(plan_id, sequence)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;item_type：出発／移動／立寄り／用事／食事／帰宅。transport_modeにDB上「バス」があるがスコープ外&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;slot_evaluation&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_slot_evaluation_plan_id_evaluation_order&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;slot_type：DEPARTURE／OUTBOUND／MAIN／RETURN（評価順はMAIN→OUTBOUND→DEPARTURE→RETURN）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;agent_session&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_agent_session_plan_id(plan_id)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;生プロンプト全文は保存しない（要約・判定結果のみ）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;routine&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_routine_user_id(user_id)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;is_skippedは単発スキップ（翌日の解除方法は2.11で決定）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;memo&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_memo_user_id_created_at(user_id, created_at)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;作成7日後に日次バッチで物理削除。checked_linesは0始まりの行番号配列&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;calendar_integration&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;uq_..._user_id_provider（UNIQUE）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;provider：Google／Outlook。トークン本体はSecrets Manager（物理設計ではsecret_name 1件に集約：エンティティ定義の回答）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;calendar_event&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_..._user_id、idx_..._calendar_integration_id&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;当日分のみ保持（前日以前は日次削除）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;departure_log&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_..._user_id、idx_..._plan_id&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;Web版では書き込まない（出発検知は範囲外）。テーブルは定義どおり作成&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;point_program&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;idx_point_program_user_id(user_id)&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;選択肢は6種（rakuten／vpoint／dpoint／ponta／waon／nanaco）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;全テーブル&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;外部キーはすべて ON DELETE RESTRICT&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;退会時は子テーブルから順に物理削除（単一トランザクション）。userのis_deleted（論理削除）との関係は2.11で決定&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="1480" y="120" width="820" height="264" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8_289" name="06_サーバ構成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c290" value="&lt;b&gt;06 サーバ内部構成（方針）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c291" value="ADR-0001に基づく。依存の向きは上→下のみ（routes→services→agent/adapters→repositories）。ルートから直接DB・外部APIを呼ばない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c292" value="&lt;b&gt;routes（Fastifyプラグイン）&lt;/b&gt;&lt;hr&gt;/api/health・/api/health/ready（認証不要）&lt;br&gt;/api/profile・/api/geo/*&lt;br&gt;/api/memos・/api/routines&lt;br&gt;/api/calendar・/api/integrations（callbackは認証不要）&lt;br&gt;/api/privacy・point・notification-settings&lt;br&gt;/api/account・/api/speech（501）&lt;br&gt;/agent/plans/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c293" value="&lt;b&gt;plugins（横断処理）&lt;/b&gt;&lt;hr&gt;JWT検証（aws-jwt-verify、Cognito）&lt;br&gt;共通エラー形式（AppError→Error）&lt;br&gt;リクエストID（形式チェック）&lt;br&gt;Feature Flag（既定OFF）&lt;br&gt;1日の生成上限（20回・JST0時リセット）&lt;br&gt;ログのクエリ文字列除去（2.8）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="295" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c294" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c292" target="c293"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c295" value="&lt;b&gt;services（業務ロジック）&lt;/b&gt;&lt;hr&gt;ProfileService&lt;br&gt;MemoService・RoutineService&lt;br&gt;CalendarService・IntegrationService&lt;br&gt;SettingsService（privacy・point・notification）&lt;br&gt;AccountService（全端末ログアウト・退会）&lt;br&gt;PlanService（計画の取得・保存・削除再評価）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c296" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c293" target="c295"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c297" value="&lt;b&gt;agent（AI連携基盤）&lt;/b&gt;&lt;hr&gt;Orchestrator（Converse Tool Useループ・13秒打切り）&lt;br&gt;Guardrail（指示とユーザー由来データの分離）&lt;br&gt;IntentAnalyzer・MemoItemExtractor&lt;br&gt;ClarificationController（最大2回→仮定）&lt;br&gt;SlotEngine（テンプレート・評価順MAIN→OUTBOUND→DEPARTURE→RETURN）&lt;br&gt;Tools：DepartureTime／TransitRoute／StationExit／MoveRoute／StoreSearch／Calendar&lt;br&gt;ConsistencyValidator（外部結果と照合）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="825" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c298" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c295" target="c297"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c299" value="&lt;b&gt;adapters（外部接続）&lt;/b&gt;&lt;hr&gt;BedrockClient&lt;br&gt;GoogleMapsClient（Geocoding API・Places API (New)・Routes API）&lt;br&gt;NavitimeClient（RapidAPI）&lt;br&gt;GoogleCalendarClient・GraphClient&lt;br&gt;SecretsClient・CognitoAdminClient&lt;br&gt;共通：タイムアウト・リトライ・呼び出し回数メトリクス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c300" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c297" target="c299"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c301" value="&lt;b&gt;repositories（Drizzle ORM）&lt;/b&gt;&lt;hr&gt;users・plans・planItems・slotEvaluations&lt;br&gt;agentSessions・routines・memos&lt;br&gt;calendarIntegrations・calendarEvents&lt;br&gt;departureLogs・pointPrograms&lt;br&gt;トランザクション（退会の一括物理削除）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#333333;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1355" y="120" width="255" height="330" as="geometry"/></mxCell><mxCell id="c302" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c299" target="c301"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c303" value='&lt;table style="border-collapse:collapse;width:1590px;font-size:11px;"&gt;&lt;colgroup&gt;&lt;col style="width:330px"&gt;&lt;col style="width:1060px"&gt;&lt;col style="width:200px"&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;ディレクトリ（server/src）&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;置くもの&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;WBS&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;config.ts・errors.ts・app.ts・server.ts&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;設定読込（zod）、共通エラー、アプリ組み立て、起動（作成済み）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;1.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plugins/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;auth.ts・feature-flags.ts・rate-limit.ts・request-log.ts&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;2.8・3.2・5.9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;routes/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;health.ts（作成済み）、profile.ts、geo.ts、memos.ts、routines.ts、calendar.ts、integrations.ts、settings.ts、account.ts、speech.ts、plans.ts&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;4.4・5.8・7.1・8.x&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;services/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;業務ロジック（DBと外部APIの組み合わせ）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;4.4〜8.3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;agent/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;orchestrator.ts、guardrail.ts、intent/、clarification.ts、slots/（template.ts・engine.ts）、tools/、validator.ts、prompts/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.1〜5.10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;adapters/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;bedrock.ts、google-maps.ts、navitime.ts、google-calendar.ts、ms-graph.ts、secrets.ts、cognito-admin.ts&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;3.3・8.1・8.2・8.3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;db/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;schema.ts（Drizzle）、client.ts、migrations/（drizzle-kit）、repositories/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;2.9・3.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;batch/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;memo-cleanup.ts、calendar-cache-cleanup.ts、stubs（運行監視・段階通知）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;7.2・8.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;server/test/&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;単体テスト（外部APIはモック）。ファイル名 *.test.ts&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;各タスク&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="1590" height="224" as="geometry"/></mxCell><mxCell id="c304" value="&lt;b&gt;守ること&lt;/b&gt;：APIの入出力は api/openapi.yaml と一致させる（変更時はOpenAPIを先に直す）／ユーザーIDはJWTのsubから取り、リクエストからは受け取らない／他ユーザーのデータは404で返す／ログにパスワード・トークン・APIキー・位置座標・住所クエリを出さない／外部APIの結果で確認できない駅名・店舗名・出口は表示しない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1590" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p20_305" name="07_シーケンス_認証・オンボーディング"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c306" value="&lt;b&gt;07 シーケンス：認証・オンボーディング&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c307" value="要件2.2.1・2.2.8・3.3.1。メール変更（プロファイル編集）もCognitoの確認コードフローで行う。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c308" value="ブラウザ&lt;br&gt;（Flutter Web）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="126.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c309" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="160" as="sourcePoint"/><mxPoint x="206.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c310" value="Cognito&lt;br&gt;（Amplify）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c311" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="160" as="sourcePoint"/><mxPoint x="518.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c312" value="サーバ&lt;br&gt;/api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="750.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c313" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="160" as="sourcePoint"/><mxPoint x="830.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c314" value="Google Maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1062.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c315" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1142.0" y="160" as="sourcePoint"/><mxPoint x="1142.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c316" value="Aurora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1374.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c317" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1454.0" y="160" as="sourcePoint"/><mxPoint x="1454.0" y="902" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c318" value="1. signUp（メール・パスワード：8文字以上・大小英字・数字）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="190" as="sourcePoint"/><mxPoint x="518.0" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c319" value="2. 確認コードをメール送信" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="228" as="sourcePoint"/><mxPoint x="206.0" y="228" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c320" value="3. confirmSignUp（6桁コード）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="266" as="sourcePoint"/><mxPoint x="518.0" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c321" value="4. signIn" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="304" as="sourcePoint"/><mxPoint x="518.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c322" value="5. JWT（IDトークン・アクセストークン・リフレッシュトークン）" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="342" as="sourcePoint"/><mxPoint x="206.0" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c323" value="6. GET /api/profile（Authorization: Bearer &lt;アクセストークン&gt;）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="380" as="sourcePoint"/><mxPoint x="830.0" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c324" value="7. JWT検証（署名・期限・User Pool・token_use）→ sub を取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="838.0" y="404" width="560" height="28" as="geometry"/></mxCell><mxCell id="c325" value="8. user を sub で検索" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="456" as="sourcePoint"/><mxPoint x="1454.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c326" value="9. 未登録なら onboardingCompleted=false の初期値を返す" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="494" as="sourcePoint"/><mxPoint x="206.0" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c327" value="10. オンボーディング Step1〜6 を表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="214.0" y="518" width="560" height="28" as="geometry"/></mxCell><mxCell id="c328" value="11. GET /api/geo/address-suggestions?q=…（Step1）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="570" as="sourcePoint"/><mxPoint x="830.0" y="570" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c329" value="12. Places API (New) Autocomplete（サーバ用キー）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="608" as="sourcePoint"/><mxPoint x="1142.0" y="608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c330" value="13. 候補（placeId・description）" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="646" as="sourcePoint"/><mxPoint x="206.0" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c331" value="14. PUT /api/profile（homeAddress・homePlaceId・…・acceptTerms・completeOnboarding）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="684" as="sourcePoint"/><mxPoint x="830.0" y="684" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c332" value="15. Geocoding API（placeId → 緯度経度）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="722" as="sourcePoint"/><mxPoint x="1142.0" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c333" value="16. user を登録・更新（同意日時・オンボーディング完了）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="760" as="sourcePoint"/><mxPoint x="1454.0" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c334" value="17. Profile（onboardingCompleted=true）→ ホームへ" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="798" as="sourcePoint"/><mxPoint x="206.0" y="798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c335" value="以降、アクセストークン期限切れ時はAmplifyがリフレッシュ。無操作24時間でセッション終了（定数）。ログイン失敗によるロックはなし（定数で将来有効化可能）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="824" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c336" value="・user_id を Cognito sub（文字列）とするか、user.id（INT）＋cognito_user_id とするかは WBS 2.11 で決定（エンティティ定義の回答は sub で統一を推奨）。&lt;br&gt;・パスワードリセットはブラウザ⇔Cognito のみで完結（サーバは関与しない）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="884" width="1580" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p15_337" name="08_シーケンス_行動計画生成"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c338" value="&lt;b&gt;08 シーケンス：行動計画生成（確認質問・スロット評価）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c339" value="要件1.4・3.2.1・3.3.1・3.4。修正（revise）と項目削除も同じ流れで、影響するスロットのみ再評価する。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c340" value="ブラウザ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="100.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c341" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="160" as="sourcePoint"/><mxPoint x="180.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c342" value="サーバ /agent&lt;br&gt;（Orchestrator）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="360.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c343" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="160" as="sourcePoint"/><mxPoint x="440.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c344" value="Aurora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="620.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c345" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700.0" y="160" as="sourcePoint"/><mxPoint x="700.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c346" value="カレンダーAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="880.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c347" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="160" as="sourcePoint"/><mxPoint x="960.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c348" value="Bedrock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1140.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c349" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="160" as="sourcePoint"/><mxPoint x="1220.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c350" value="NAVITIME／Google Maps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c351" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480.0" y="160" as="sourcePoint"/><mxPoint x="1480.0" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c352" value="1. POST /agent/plans { inputText（≦500文字） }" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="190" as="sourcePoint"/><mxPoint x="440.0" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c353" value="2. JWT検証 → 生成回数チェック（20回/日超過で429、Retry-After）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="448.0" y="214" width="560" height="28" as="geometry"/></mxCell><mxCell id="c354" value="3. プロファイル・当日のルーティン（スキップ除く）・メモ（メモ同意ON時）を取得" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="266" as="sourcePoint"/><mxPoint x="700.0" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c355" value="4. 当日の予定を取得（カレンダー同意ONかつ連携済み時。キャッシュに頼らず毎回取得）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="304" as="sourcePoint"/><mxPoint x="960.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c356" value="5. plan を作成（status=generating）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="342" as="sourcePoint"/><mxPoint x="700.0" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c357" value="6. 意図解析（指示とユーザー由来データを分離して渡す。メモから品目抽出）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="380" as="sourcePoint"/><mxPoint x="1220.0" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c358" value="alt［必須情報（時刻・場所など）が不足］" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c359" value="7. status=clarifying、clarification_count+1、agent_session（確認質問の要約）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="456" as="sourcePoint"/><mxPoint x="700.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c360" value="8. 201 Plan（clarification.question・count）→ 入力欄を質問カードに切替" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="494" as="sourcePoint"/><mxPoint x="180.0" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c361" value="9. POST /agent/plans/{id}/clarify { answer }（2回目まで。2回後も不足なら仮定をassumptionsに明示して続行）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="180.0" y="532" as="sourcePoint"/><mxPoint x="440.0" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c362" value="情報がそろった後" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c363" value="10. スロットを作成（DEPARTURE／OUTBOUND／MAIN／RETURN）→ MAIN→OUTBOUND→DEPARTURE→RETURN の順に評価" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="448.0" y="594" width="560" height="28" as="geometry"/></mxCell><mxCell id="c364" value="11. 各スロットの判断（Tool Use：TransitRoute・StationExit・MoveRoute・StoreSearch・DepartureTime）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="646" as="sourcePoint"/><mxPoint x="1220.0" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c365" value="12. ツール実行：乗換経路・駅出口・徒歩/自転車/車ルート・店舗（営業時間）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="684" as="sourcePoint"/><mxPoint x="1480.0" y="684" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c366" value="13. 結果" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1480.0" y="722" as="sourcePoint"/><mxPoint x="440.0" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c367" value="14. 整合性検証：外部APIで確認できない駅名・店舗名・出口を除外（取れない駅出口は表示しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="448.0" y="746" width="560" height="28" as="geometry"/></mxCell><mxCell id="c368" value="15. plan_item・slot_evaluation（全スロット評価済み）・agent_session（要約のみ）を保存、status=completed、生成回数+1" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="798" as="sourcePoint"/><mxPoint x="700.0" y="798" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c369" value="16. 201 Plan（items・departureTime・returnTime・assumptions・warnings・quota）" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440.0" y="836" as="sourcePoint"/><mxPoint x="180.0" y="836" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c370" value="例外：13秒超過 → 502 EXTERNAL_SERVICE_ERROR（生成回数に数えない）／Bedrock失敗 → status=error・502／ブラウザは15秒でタイムアウト表示＋再試行" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c371" value="・「検討すべき項目の一覧はプログラムが管理し、判断はAIが担う」：スロットの一覧と評価順はコード（SlotEngine）で固定し、AIに省略させない。&lt;br&gt;・計画は当日・外出から帰宅までの1往復のみ。移動手段は徒歩・自転車・車・電車（バス・タクシーは提案しない）。&lt;br&gt;・生成回数に数えるAPI（clarify・revise・項目削除を含めるか）は5.9で決定（15ページ）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="922" width="1580" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p16_372" name="09_シーケンス_カレンダー連携"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c373" value="&lt;b&gt;09 シーケンス：カレンダー連携（Google／Outlook）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c374" value="要件4.3.1、エンティティ定義の未確定事項の回答（トークン本体はSecrets Manager、DBはメタデータのみ）。Outlookも同じ流れ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c375" value="ブラウザ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="126.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c376" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="160" as="sourcePoint"/><mxPoint x="206.0" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c377" value="サーバ /api" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="438.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c378" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="160" as="sourcePoint"/><mxPoint x="518.0" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c379" value="Secrets Manager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="750.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c380" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="160" as="sourcePoint"/><mxPoint x="830.0" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c381" value="Aurora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1062.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c382" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1142.0" y="160" as="sourcePoint"/><mxPoint x="1142.0" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c383" value="Google／Microsoft&lt;br&gt;OAuth・カレンダーAPI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1374.0" y="110" width="160" height="50" as="geometry"/></mxCell><mxCell id="c384" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1454.0" y="160" as="sourcePoint"/><mxPoint x="1454.0" y="826" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c385" value="1. POST /api/integrations/google（JWTあり）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="190" as="sourcePoint"/><mxPoint x="518.0" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c386" value="2. state を生成し、ユーザーと紐付けて短時間保存（保存先は8.1で決定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="526.0" y="214" width="560" height="28" as="geometry"/></mxCell><mxCell id="c387" value="3. 200 { authorizationUrl }（scope：calendar.readonly ／ Graph は Calendars.Read）" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="266" as="sourcePoint"/><mxPoint x="206.0" y="266" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c388" value="4. 同意画面へ遷移 → 利用者が同意（拒否時は error=access_denied）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="206.0" y="304" as="sourcePoint"/><mxPoint x="1454.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c389" value="5. GET /api/integrations/google/callback?code&amp;state（JWTなし）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1454.0" y="342" as="sourcePoint"/><mxPoint x="518.0" y="342" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c390" value="6. state を照合（不一致・期限切れは拒否）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;align=left;spacingLeft=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="526.0" y="366" width="560" height="28" as="geometry"/></mxCell><mxCell id="c391" value="7. code をトークンに交換" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="418" as="sourcePoint"/><mxPoint x="1454.0" y="418" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c392" value="8. integration/{user_id}/google にトークンJSON（期限含む）を保存" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="456" as="sourcePoint"/><mxPoint x="830.0" y="456" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c393" value="9. calendar_integration を登録・更新（provider・状態・secret名のみ。トークンは保存しない）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="494" as="sourcePoint"/><mxPoint x="1142.0" y="494" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c394" value="10. 302 → 設定画面（またはStep5） ?integration=connected|denied|error" style="endArrow=open;dashed=1;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="532" as="sourcePoint"/><mxPoint x="206.0" y="532" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c395" value="予定の取得（計画生成時・GET /api/calendar/events）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c396" value="11. トークン取得（期限切れならリフレッシュして保存し直す。失敗時は状態をERRORにし予定なしで続行）" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="608" as="sourcePoint"/><mxPoint x="830.0" y="608" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c397" value="12. 当日の予定を取得 → calendar_event に当日分をキャッシュ" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="646" as="sourcePoint"/><mxPoint x="1454.0" y="646" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c398" value="解除：DELETE /api/integrations/{provider}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="672" width="1580" height="24" as="geometry"/></mxCell><mxCell id="c399" value="13. シークレットを削除" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="722" as="sourcePoint"/><mxPoint x="830.0" y="722" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c400" value="14. calendar_event（該当連携分）を削除、calendar_integration を無効化" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="518.0" y="760" as="sourcePoint"/><mxPoint x="1142.0" y="760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c401" value="・退会時は integration/{user_id}/* のシークレットを一括削除する。&lt;br&gt;・カレンダー予定の件名をAIに渡すのはカレンダー同意ON時のみ。件名はデータとして扱い、指示として解釈させない（ガードレール）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="808" width="1580" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7_402" name="10_状態遷移"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c403" value="&lt;b&gt;10 状態遷移：行動計画ステータスとスロット評価&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c404" value="plan.status（DB値：生成中／確認質問中／完了／エラー）。API値は generating／clarifying／completed／error。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c405" value="" style="ellipse;html=1;fillColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="230" width="30" height="30" as="geometry"/></mxCell><mxCell id="c406" value="generating&lt;br&gt;生成中" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="215" width="160" height="60" as="geometry"/></mxCell><mxCell id="c407" value="clarifying&lt;br&gt;確認質問中" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="100" width="160" height="60" as="geometry"/></mxCell><mxCell id="c408" value="completed&lt;br&gt;完了" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="160" height="60" as="geometry"/></mxCell><mxCell id="c409" value="error&lt;br&gt;エラー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="180" y="420" width="160" height="60" as="geometry"/></mxCell><mxCell id="c410" value="createPlan" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c405" target="c406"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c411" value="必須情報不足&lt;br&gt;かつ count＜2" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c406" target="c407"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="130"/></Array></mxGeometry></mxCell><mxCell id="c412" value="clarify（回答）&lt;br&gt;count≦2" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c407" target="c406"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="245"/><mxPoint x="380" y="245"/></Array></mxGeometry></mxCell><mxCell id="c413" value="全スロット評価済み&lt;br&gt;整合性検証OK" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c406" target="c408"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="360"/></Array></mxGeometry></mxCell><mxCell id="c414" value="revise／項目削除&lt;br&gt;（影響スロットを再評価）" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c408" target="c406"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="300"/><mxPoint x="380" y="300"/><mxPoint x="380" y="260"/></Array></mxGeometry></mxCell><mxCell id="c415" value="Bedrock失敗&lt;br&gt;13秒超過" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c406" target="c409"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c416" value="・2回目の回答後も情報が不足する場合は clarifying に戻さず、仮定（assumptions）を明示して completed にする（無限ループ防止）。&lt;br&gt;・clarifying 以外の計画に clarify を送ると 409 CONFLICT。&lt;br&gt;・error の計画は再試行（新しい createPlan）で作り直す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="640" height="100" as="geometry"/></mxCell><mxCell id="c417" value="&lt;b&gt;スロット評価テンプレート（プログラムで固定）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="800" height="24" as="geometry"/></mxCell><mxCell id="c418" value="&lt;b&gt;DEPARTURE&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;出発：出発時刻の逆算（到着必須時刻−移動−余裕）、準備開始の目安&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="140" width="520" height="64" as="geometry"/></mxCell><mxCell id="c419" value="評価順 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="156" width="100" height="32" as="geometry"/></mxCell><mxCell id="c420" value="&lt;b&gt;OUTBOUND&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;往路：自宅→最初の目的地の移動（電車・徒歩・自転車・車）、駅出口・乗車位置&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="224" width="520" height="64" as="geometry"/></mxCell><mxCell id="c421" value="評価順 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="100" height="32" as="geometry"/></mxCell><mxCell id="c422" value="&lt;b&gt;MAIN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;主目的：用事・待ち合わせ・ルーティン・カレンダー予定・立寄り（買い物）・食事、回遊順の最適化&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="308" width="520" height="64" as="geometry"/></mxCell><mxCell id="c423" value="評価順 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="324" width="100" height="32" as="geometry"/></mxCell><mxCell id="c424" value="&lt;b&gt;RETURN&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;復路：最後の目的地→自宅、帰宅時刻&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="780" y="392" width="520" height="64" as="geometry"/></mxCell><mxCell id="c425" value="評価順 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1320" y="408" width="100" height="32" as="geometry"/></mxCell><mxCell id="c426" value="・計画の並び（時系列）は DEPARTURE→OUTBOUND→MAIN→RETURN、AIの評価順は MAIN→OUTBOUND→DEPARTURE→RETURN（主目的が決まらないと移動と出発時刻が決まらないため）。&lt;br&gt;・全スロットについて slot_evaluation に評価結果を記録し、is_evaluated=1 にする（監査ログ）。省略は不可。&lt;br&gt;・plan_item.item_type（出発／移動／立寄り／用事／食事／帰宅）は各スロットの結果として作られる。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="490" width="820" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11_427" name="11_API一覧マップ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c428" value="&lt;b&gt;11 API一覧マップ（api/openapi.yaml v0.2.x）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c429" value="認証：ヘルスチェックとOAuthコールバック以外はJWT必須。他ユーザーのデータは404。準備のみのAPIは501 FEATURE_DISABLED。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c430" value='&lt;table style="border-collapse:collapse;width:2270px;font-size:12px;"&gt;&lt;colgroup&gt;&lt;col style="width:420px"&gt;&lt;col style="width:330px"&gt;&lt;col style="width:330px"&gt;&lt;col style="width:650px"&gt;&lt;col style="width:340px"&gt;&lt;col style="width:120px"&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;Method / Path&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;operationId&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;画面&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;主なテーブル（R:参照 W:更新 D:削除）&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;外部サービス&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;WBS&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;GET /api/health&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;getHealth&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー（ALB）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;1.5済&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;GET /api/health/ready&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;getReadiness&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;SELECT 1&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;1.5済&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;POST /agent/plans&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;createPlan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ホーム&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;user R, routine R, memo R, plan W, plan_item W, slot_evaluation W, agent_session W&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;Bedrock, NAVITIME, Maps, カレンダー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;GET /agent/plans/{planId}&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;getPlan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;結果&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan R, plan_item R&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;POST /agent/plans/{planId}/clarify&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;answerClarification&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ホーム&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan W, agent_session W ほか生成と同じ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;生成と同じ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;POST /agent/plans/{planId}/revise&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;revisePlan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;結果&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan W, plan_item W, slot_evaluation W, agent_session W&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;生成と同じ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;DELETE /agent/plans/{planId}/items/{itemId}&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;deletePlanItem&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;結果&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;plan_item D/W, slot_evaluation W&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;Bedrock, NAVITIME, Maps&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;POST /agent/plans/{planId}/replan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;replanPlan&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;結果（延期ボタン）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー（501）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ー&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;5.9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;POST /agen