<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="p8_2" name="00_表紙・目次"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;AIスケジュール外出支援サービス（Web版）詳細設計書&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c4" value="版数 0.1（2026-10-16） 作成：Claude／承認：前田　｜　正とする資料：要件定義書・見積書・DB定義書・エンティティ定義・api/openapi.yaml・docs/adr" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c5" value='&lt;table style="border-collapse:collapse;width:1100px;font-size:11px;"&gt;&lt;colgroup&gt;&lt;col style="width:40px"&gt;&lt;col style="width:260px"&gt;&lt;col style="width:480px"&gt;&lt;col style="width:320px"&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;No&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;ページ&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;内容&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;主な参照元&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;01&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;システムアーキテクチャ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;AWS構成と外部サービス、データの流れ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件4.1〜4.3、見積書5章&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;02&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ネットワーク・SG&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;VPC・サブネット・セキュリティグループ・通信経路&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件4.2.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;03&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ユースケース図&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;利用者・外部サービスと機能の関係（Web版スコープ）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件1.3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;04&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;画面遷移図&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;画面・モーダルの遷移と呼び出すAPI&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件2.1.2、2.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;05&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ER図&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;DB定義書どおりの11テーブル・外部キー・インデックス&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;DB定義書&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;06&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;サーバ構成&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;サーバ内部のレイヤー・モジュール・ディレクトリ方針&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;ADR-0001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;07&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;シーケンス：認証・オンボーディング&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;Cognito認証からプロファイル保存まで&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件2.2.1、1.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;08&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;シーケンス：行動計画生成&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;確認質問・スロット評価・外部API・整合性検証&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件1.4、3.2.1、3.3.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;09&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;シーケンス：カレンダー連携&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;OAuth開始・コールバック・解除&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件4.3.1、エンティティ定義&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;10&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;状態遷移&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;行動計画のステータスとスロット評価順序&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件1.2、DB定義書2.2・2.4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;11&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;API一覧マップ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;API × 画面 × テーブル × 外部サービス&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;api/openapi.yaml&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;12&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;列挙値対応表&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;APIの英字コードとDB値・画面表示の対応&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;openapi、DB定義書&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;13&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;バッチ・データ保持&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;バッチ一覧、保持期間、退会時の削除範囲&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件2.3、3.2.2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;14&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;環境・デプロイ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;開発／検証／本番の差分とCI/CDの流れ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;要件4.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;15&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;決定事項・未決事項&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;作業時に迷わないための決定一覧と、未決事項の決定期限&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;会話・Wrike&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1100" height="344" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;凡例&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="400" height="20" as="geometry"/></mxCell><mxCell id="c7" value="AWSのサービス（本システムで構築）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1180" y="140" width="300" height="30" as="geometry"/></mxCell><mxCell id="c8" value="データストア" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1180" y="180" width="300" height="30" as="geometry"/></mxCell><mxCell id="c9" value="セキュリティ・認証" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1180" y="220" width="300" height="30" as="geometry"/></mxCell><mxCell id="c10" value="外部サービス（AWS外）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="260" width="300" height="30" as="geometry"/></mxCell><mxCell id="c11" value="準備のみ（Feature Flag OFF）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1180" y="300" width="300" height="30" as="geometry"/></mxCell><mxCell id="c12" value="範囲外（Web版では作らない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#BBBBBB;dashed=1;fontColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="1180" y="340" width="300" height="30" as="geometry"/></mxCell><mxCell id="c13" value="未決・案（決定後に更新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="380" width="300" height="30" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;前提（変更する場合は先に本書を更新）&lt;/b&gt;&lt;br&gt;・提供形態はWebアプリのみ（Windows上のEdge／Chrome最新版）。iOS／Android、出発検知、プッシュ通知、オフライン同期は範囲外。&lt;br&gt;・音声入力・延期再計画・出発アラート・運行監視・出発検知APIは準備のみ（Feature Flag OFF、APIは501）。&lt;br&gt;・サーバはTypeScript（Node.js 22）＋Fastify 5の単一サービス。/api と /agent を同居。&lt;br&gt;・DBはAurora Serverless v2（PostgreSQL 16）。DB定義書の型表記（INT／DATETIME／TINYINT等）はMySQL表記のため、PostgreSQLへの読み替えはWBS 2.11で決める。&lt;br&gt;・本書と資料が食い違う場合は、要件定義書 ＞ api/openapi.yaml ＞ 本書の順に正とし、食い違いは15ページに記録する。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1180" y="440" width="440" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p14_15" name="01_システムアーキテクチャ"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c16" value="&lt;b&gt;01 システムアーキテクチャ（AWS 東京リージョン）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c17" value="Web版。ブラウザ→CloudFront（WAF）→ S3（画面）／ALB→ECS（/api・/agent）。認証はブラウザからCognitoへ直接。外部APIはECSからNAT経由で呼ぶ。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c18" value="利用者&lt;br&gt;Windows＋Edge／Chrome&lt;br&gt;（Flutter Web）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="150" height="80" as="geometry"/></mxCell><mxCell id="c19" value="AWS Cloud（ap-northeast-1）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="110" width="1060" height="900" as="geometry"/></mxCell><mxCell id="c20" value="AWS WAF&lt;br&gt;（レート制限・マネージドルール）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="260" y="300" width="160" height="60" as="geometry"/></mxCell><mxCell id="c21" value="CloudFront&lt;br&gt;/ → S3&lt;br&gt;/api/*・/agent/* → ALB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="160" height="80" as="geometry"/></mxCell><mxCell id="c22" value="S3 web-assets&lt;br&gt;（Flutter Web成果物・バージョニング有効）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="260" y="560" width="160" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Cognito User Pool&lt;br&gt;メール＋パスワード&lt;br&gt;Web用App Client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="260" y="160" width="160" height="70" as="geometry"/></mxCell><mxCell id="c24" value="VPC（Multi-AZ。CIDRは1.10の接続情報で確定）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="560" height="560" as="geometry"/></mxCell><mxCell id="c25" value="パブリックサブネット" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E6;strokeColor=#7AA116;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="180" width="520" height="110" as="geometry"/></mxCell><mxCell id="c26" value="ALB＋ACM&lt;br&gt;HTTPS 443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="500" y="215" width="150" height="60" as="geometry"/></mxCell><mxCell id="c27" value="NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="820" y="215" width="150" height="60" as="geometry"/></mxCell><mxCell id="c28" value="プライベート（アプリ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="310" width="520" height="200" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;ECS Fargate サービス（単一コンテナ）&lt;/b&gt;&lt;br&gt;/api/*：APIサービス&lt;br&gt;/agent/*：AI連携基盤&lt;br&gt;JWT検証・Feature Flag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="500" y="340" width="260" height="100" as="geometry"/></mxCell><mxCell id="c30" value="バッチ（ECSタスク）&lt;br&gt;メモ自動削除・カレンダー予定キャッシュ削除&lt;br&gt;※起動方式は7.2で確定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="780" y="340" width="200" height="100" as="geometry"/></mxCell><mxCell id="c31" value="プライベート（データ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="530" width="520" height="150" as="geometry"/></mxCell><mxCell id="c32" value="Aurora Serverless v2&lt;br&gt;PostgreSQL 16&lt;br&gt;KMS暗号化・自動バックアップ7日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="560" y="570" width="260" height="80" as="geometry"/></mxCell><mxCell id="c33" value="Secrets Manager&lt;br&gt;DB認証情報・外部APIキー&lt;br&gt;integration/{user_id}/{provider}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="c34" value="Amazon Bedrock&lt;br&gt;Claude（Converse API・Tool Use）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1060" y="280" width="200" height="70" as="geometry"/></mxCell><mxCell id="c35" value="EventBridge Scheduler&lt;br&gt;日次バッチ起動&lt;br&gt;運行監視・段階通知は準備のみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1060" y="390" width="200" height="80" as="geometry"/></mxCell><mxCell id="c36" value="CloudWatch Logs／Alarms&lt;br&gt;ログ保持90日" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1060" y="510" width="200" height="60" as="geometry"/></mxCell><mxCell id="c37" value="SNS（アラーム通知メール）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1060" y="600" width="200" height="50" as="geometry"/></mxCell><mxCell id="c38" value="S3 logs（アクセスログ・90日で削除）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1060" y="680" width="200" height="50" as="geometry"/></mxCell><mxCell id="c39" value="Transit Gateway&lt;br&gt;（社内ネットワーク接続）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="560" y="730" width="200" height="60" as="geometry"/></mxCell><mxCell id="c40" value="CI/CD：ソースzip → S3（deploy） → CodePipeline → CodeBuild（テスト・ビルド） → ECR → ECS&lt;br&gt;Flutter Web成果物は CodeBuild → S3 web-assets ＋ CloudFront キャッシュ無効化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="260" y="840" width="1000" height="60" as="geometry"/></mxCell><mxCell id="c41" value="外部サービス（AWS外）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="300" height="520" as="geometry"/></mxCell><mxCell id="c42" value="Google Maps Platform&lt;br&gt;Geocoding API／Places API (New)／Routes API（サーバ）&lt;br&gt;Maps JavaScript API（ブラウザ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1350" y="180" width="260" height="80" as="geometry"/></mxCell><mxCell id="c43" value="乗換案内API（NAVITIME）&lt;br&gt;経路・発着時刻・乗換・駅名（駅出口・乗車位置は取得方法を検討中）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1350" y="290" width="260" height="60" as="geometry"/></mxCell><mxCell id="c44" value="Google Calendar API（OAuth）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1350" y="380" width="260" height="50" as="geometry"/></mxCell><mxCell id="c45" value="Microsoft Graph（Outlook）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1350" y="450" width="260" height="50" as="geometry"/></mxCell><mxCell id="c46" value="音声認識サービス（準備のみ）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fontColor=#999999;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1350" y="530" width="260" height="50" as="geometry"/></mxCell><mxCell id="c47" value="HTTPS" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="静的資産" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="/api・/agent" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c21" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="HTTP 3000" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c26" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="5432" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="サインイン（Amplify）→JWT" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="195"/></Array></mxGeometry></mxCell><mxCell id="c54" value="取得" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="推論" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="起動" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c35" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="ログ" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="外向き" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c29" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="HTTPS" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c27" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="245"/><mxPoint x="1000" y="120"/><mxPoint x="1480" y="120"/></Array></mxGeometry></mxCell><mxCell id="c62" value="地図描画（Web用キー）" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c18" target="c42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="105" y="1040"/><mxPoint x="1480" y="1040"/></Array></mxGeometry></mxCell><mxCell id="c63" value="アタッチ" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c39" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="・Bedrockへの経路（NAT経由かVPCエンドポイントか）は2.5で決定。&lt;br&gt;・CloudFront→ALBの経路は、ALBのSGをCloudFrontのマネージドプレフィックスリストに限定し、WAFを迂回させない（02参照）。&lt;br&gt;・JWTはALBでは検証せず、サーバのミドルウェアで検証する（要件3.1.2）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="1060" width="1500" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p12_65" name="02_ネットワーク・SG"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c66" value="&lt;b&gt;02 ネットワーク・セキュリティグループ&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c67" value="要件4.2.1：ALBは443のみ、ECSはALBからのみ、AuroraはECSからのみ。開発環境は「シングルAZ」だが、ALBとAuroraのサブネットグループは2AZ必須のためサブネットは2AZ分作る。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c68" value="VPC（CIDR：1.10の社内接続情報と重複しない範囲で決定）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1100" height="560" as="geometry"/></mxCell><mxCell id="c69" value="AZ-a（ap-northeast-1a）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="500" height="500" as="geometry"/></mxCell><mxCell id="c70" value="パブリック" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E6;strokeColor=#7AA116;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="460" height="100" as="geometry"/></mxCell><mxCell id="c71" value="ALB（ノード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="160" height="50" as="geometry"/></mxCell><mxCell id="c72" value="NAT Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="170" height="50" as="geometry"/></mxCell><mxCell id="c73" value="プライベート（アプリ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="320" width="460" height="140" as="geometry"/></mxCell><mxCell id="c74" value="ECSタスク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="100" y="360" width="220" height="60" as="geometry"/></mxCell><mxCell id="c75" value="プライベート（データ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="460" height="150" as="geometry"/></mxCell><mxCell id="c76" value="Aurora ライター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="100" y="520" width="260" height="60" as="geometry"/></mxCell><mxCell id="c77" value="AZ-c（ap-northeast-1c）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="160" width="500" height="500" as="geometry"/></mxCell><mxCell id="c78" value="パブリック" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8E6;strokeColor=#7AA116;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="200" width="460" height="100" as="geometry"/></mxCell><mxCell id="c79" value="ALB（ノード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="230" width="160" height="50" as="geometry"/></mxCell><mxCell id="c80" value="NAT Gateway&lt;br&gt;（本番・検証のみ）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="880" y="230" width="170" height="50" as="geometry"/></mxCell><mxCell id="c81" value="プライベート（アプリ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="320" width="460" height="140" as="geometry"/></mxCell><mxCell id="c82" value="ECSタスク&lt;br&gt;（本番・検証：最小2タスクで分散）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="220" height="60" as="geometry"/></mxCell><mxCell id="c83" value="プライベート（データ層）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="460" height="150" as="geometry"/></mxCell><mxCell id="c84" value="Aurora リーダー（本番・検証のMulti-AZ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="640" y="520" width="260" height="60" as="geometry"/></mxCell><mxCell id="c85" value='&lt;table style="border-collapse:collapse;width:1580px;font-size:11px;"&gt;&lt;colgroup&gt;&lt;col style="width:90px"&gt;&lt;col style="width:90px"&gt;&lt;col style="width:420px"&gt;&lt;col style="width:520px"&gt;&lt;col style="width:460px"&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;SG名&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;インバウンド&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;送信元&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;アウトバウンド&lt;/th&gt;&lt;th style="border:1px solid #888;padding:3px 5px;background:#DAE8FC;text-align:left;vertical-align:top;"&gt;備考&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;sg-alb&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;TCP 443&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;CloudFrontのマネージドプレフィックスリスト（origin-facing）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;TCP 3000 → sg-ecs&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;直接アクセスによるWAF迂回を防ぐ（推奨案、2.5で確定）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;sg-ecs&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;TCP 3000&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;sg-alb のみ&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;TCP 5432 → sg-aurora、TCP 443 → 0.0.0.0/0（NAT経由で外部API・AWS API）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;コンテナのポートは3000（server/.env.example）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;sg-aurora&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;TCP 5432&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;sg-ecs のみ（バッチタスクも sg-ecs を使う）&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;なし&lt;/td&gt;&lt;td style="border:1px solid #888;padding:3px 5px;text-align:left;vertical-align:top;"&gt;パブリックアクセス無効&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="text;html=1;whiteSpace=wrap;overflow=visible;verticalAlign=top;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="1580" height="104" as="geometry"/></mxCell><mxCell id="c86" value="&lt;b&gt;通信の約束事&lt;/b&gt;&lt;br&gt;・ブラウザ→サーバはすべてHTTPS（TLS1.2以上）。CloudFrontとALBにACM証明書（CloudFront用はus-east-1）。&lt;br&gt;・運用・保守用のアクセス経路は別途（踏み台は置かない方針。必要時はECS Exec等を検討）。&lt;br&gt;・Transit Gatewayはアプリ層サブネットのルートテーブルに社内CIDR向けルートを追加（9.3）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1160" y="140" width="460" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p10_87" name="03_ユースケース図"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c88" value="&lt;b&gt;03 ユースケース図（Web版）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c89" value="アクターは利用者、外部サービス、スケジューラ（時刻）。管理者向け機能はなし（監視はCloudWatchの通知のみ）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c90" value="利用者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="40" height="80" as="geometry"/></mxCell><mxCell id="c91" value="AIスケジュール外出支援サービス（Web版）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;dashed=0;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="110" width="1060" height="1000" as="geometry"/></mxCell><mxCell id="c92" value="認証・アカウント" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="150" width="320" height="300" as="geometry"/></mxCell><mxCell id="c93" value="サインアップ（確認コード）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="185" width="280" height="44" as="geometry"/></mxCell><mxCell id="c94" value="サインイン" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="237" width="280" height="44" as="geometry"/></mxCell><mxCell id="c95" value="パスワードリセット" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="289" width="280" height="44" as="geometry"/></mxCell><mxCell id="c96" value="全端末ログアウト" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="341" width="280" height="44" as="geometry"/></mxCell><mxCell id="c97" value="退会" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="393" width="280" height="44" as="geometry"/></mxCell><mxCell id="c98" value="初期設定・設定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="470" width="320" height="300" as="geometry"/></mxCell><mxCell id="c99" value="オンボーディング（6ステップ）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="505" width="280" height="44" as="geometry"/></mxCell><mxCell id="c100" value="プロファイル編集（メール変更含む）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="557" width="280" height="44" as="geometry"/></mxCell><mxCell id="c101" value="優先条件・ポイント・プライバシー設定" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="609" width="280" height="44" as="geometry"/></mxCell><mxCell id="c102" value="カレンダー連携・解除" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="190" y="661" width="280" height="44" as="geometry"/></mxCell><mxCell id="c103" value="通知設定（入口のみ）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="190" y="713" width="280" height="44" as="geometry"/></mxCell><mxCell id="c104" value="行動計画" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="150" width="320" height="300" as="geometry"/></mxCell><mxCell id="c105" value="用事を入力し計画を生成" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="280" height="44" as="geometry"/></mxCell><mxCell id="c106" value="確認質問に回答（最大2回）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="237" width="280" height="44" as="geometry"/></mxCell><mxCell id="c107" value="計画を確認（地図・タイムライン・詳細）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="540" y="289" width="280" height="44" as="geometry"/></mxCell><mxCell id="c108" value="計画を自然文で修正" style="ellipse;whiteSp