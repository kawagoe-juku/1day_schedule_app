mxCell id="c117" value="延期・再計画（準備のみ）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="890" y="237" width="280" height="44" as="geometry"/></mxCell><mxCell id="c118" value="出発アラート通知（準備のみ）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="890" y="289" width="280" height="44" as="geometry"/></mxCell><mxCell id="c119" value="出発検知（Web版は範囲外）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;fillColor=#EEEEEE;strokeColor=#BBBBBB;fontColor=#AAAAAA;" vertex="1" parent="1"><mxGeometry x="890" y="341" width="280" height="44" as="geometry"/></mxCell><mxCell id="c120" value="自動処理（スケジューラ）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="470" width="320" height="300" as="geometry"/></mxCell><mxCell id="c121" value="メモ自動削除（作成7日後）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="890" y="505" width="280" height="44" as="geometry"/></mxCell><mxCell id="c122" value="カレンダー予定キャッシュ削除（前日以前）" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="890" y="557" width="280" height="44" as="geometry"/></mxCell><mxCell id="c123" value="運行情報監視（準備のみ）" style="ellipse;whiteSpace=wrap;html=1;dashed=1;strokeColor=#999999;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="890" y="609" width="280" height="44" as="geometry"/></mxCell><mxCell id="c124" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c93"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c125" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c126" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c99"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c127" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c128" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c111"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c129" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c130" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c131" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c90" target="c107"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c132" value="«include»（情報不足時）" style="endArrow=open;html=1;dashed=1;" edge="1" parent="1" source="c105" target="c106"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c133" value="Cognito" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="160" width="40" height="70" as="geometry"/></mxCell><mxCell id="c134" value="Bedrock（Claude）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="300" width="40" height="70" as="geometry"/></mxCell><mxCell id="c135" value="Google Maps" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="440" width="40" height="70" as="geometry"/></mxCell><mxCell id="c136" value="乗換案内API（NAVITIME）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="580" width="40" height="70" as="geometry"/></mxCell><mxCell id="c137" value="Google／Outlook&lt;br&gt;カレンダー" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="720" width="40" height="70" as="geometry"/></mxCell><mxCell id="c138" value="スケジューラ&lt;br&gt;（EventBridge）" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1320" y="880" width="40" height="70" as="geometry"/></mxCell><mxCell id="c139" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c94" target="c133"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c140" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c105" target="c134"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c141" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c105" target="c135"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c142" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c105" target="c136"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c143" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c102" target="c137"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c144" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c121" target="c138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c145" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="c122" target="c138"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c146" value="・計画生成は、登録済みルーティン（当日・スキップ除く）、メモの品目（メモ利用同意ON時）、当日のカレンダー予定（カレンダー同意ON時、生成のたびに取得）を自動で取り込む。&lt;br&gt;・利用者からの線は代表的なユースケースのみ描画。枠内のすべてのユースケースは利用者が起点。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="150" y="1120" width="1300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p8_147" name="04_画面遷移図"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c148" value="&lt;b&gt;04 画面遷移図&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c149" value="要件2.1.2をWeb版に合わせて記載。各画面の下段は呼び出すAPI（api/openapi.yaml のoperationId）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c150" value="&lt;b&gt;ログイン／初回オンボーディング（2.2.1）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;Cognito（Amplify）&lt;br&gt;getProfile・updateProfile&lt;br&gt;suggestAddresses・suggestStations&lt;br&gt;startIntegration（Step5）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="260" height="130" as="geometry"/></mxCell><mxCell id="c151" value="パスワードリセット&lt;br&gt;モーダル（2.2.8）" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="c152" value="&lt;b&gt;ホーム／入力（2.2.2）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;createPlan・answerClarification&lt;br&gt;（確認質問はインライン表示）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="160" width="250" height="110" as="geometry"/></mxCell><mxCell id="c153" value="&lt;b&gt;行動計画結果（2.2.3）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;getPlan・revisePlan・deletePlanItem&lt;br&gt;replanPlan（準備のみ）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="160" width="250" height="110" as="geometry"/></mxCell><mxCell id="c154" value="&lt;b&gt;ルーティン設定（2.2.4）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;listRoutines・createRoutine&lt;br&gt;updateRoutine・deleteRoutine&lt;br&gt;setRoutineSkip&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="250" height="110" as="geometry"/></mxCell><mxCell id="c155" value="&lt;b&gt;メモ・買い物リスト（2.2.5）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;listMemos・createMemo&lt;br&gt;updateMemo・deleteMemo&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="250" height="110" as="geometry"/></mxCell><mxCell id="c156" value="&lt;b&gt;アカウント・設定（2.2.6）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;getProfile・updateProfile（優先条件）&lt;br&gt;listPointPrograms・updatePointPrograms&lt;br&gt;get/updatePrivacySettings&lt;br&gt;listIntegrations・start/deleteIntegration&lt;br&gt;get/updateNotificationSettings&lt;br&gt;logoutAllDevices&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="300" height="150" as="geometry"/></mxCell><mxCell id="c157" value="&lt;b&gt;プロファイル編集（2.2.7）&lt;/b&gt;&lt;hr&gt;&lt;span style='font-size:10px'&gt;getProfile・updateProfile&lt;br&gt;suggestAddresses・suggestStations&lt;br&gt;Cognito（メール変更の確認コード）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="820" y="660" width="250" height="110" as="geometry"/></mxCell><mxCell id="c158" value="退会確認ダイアログ（2.2.9）&lt;br&gt;deleteAccount" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="420" y="860" width="300" height="70" as="geometry"/></mxCell><mxCell id="c159" value="削除確認ダイアログ（2.2.10）" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1180" y="470" width="220" height="70" as="geometry"/></mxCell><mxCell id="c160" value="Google／Microsoftの同意画面&lt;br&gt;（外部）→ callback → 元画面へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1180" y="690" width="240" height="70" as="geometry"/></mxCell><mxCell id="c161" value="認証成功・オンボーディング完了" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c150" target="c152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c162" value="パスワードを忘れた場合" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c150" target="c151"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c163" value="完了／キャンセル" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c151" target="c150"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="435"/><mxPoint x="330" y="260"/></Array></mxGeometry></mxCell><mxCell id="c164" value="計画生成（completed）" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c152" target="c153"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c165" value="戻る" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c153" target="c152"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="120"/><mxPoint x="545" y="120"/></Array></mxGeometry></mxCell><mxCell id="c166" value="ルーティン" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c152" target="c154"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c167" value="メモ" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c152" target="c155"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="300"/><mxPoint x="925" y="300"/></Array></mxGeometry></mxCell><mxCell id="c168" value="設定" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c152" target="c156"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="240"/><mxPoint x="390" y="715"/></Array></mxGeometry></mxCell><mxCell id="c169" value="プロファイル編集" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c156" target="c157"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c170" value="退会" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c156" target="c158"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c171" value="退会完了" style="endArrow=block;html=1;rounded=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c158" target="c150"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="895"/></Array></mxGeometry></mxCell><mxCell id="c172" value="削除" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c154" target="c159"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="545" y="560"/><mxPoint x="1290" y="560"/></Array></mxGeometry></mxCell><mxCell id="c173" value="削除" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c155" target="c159"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c174" value="カレンダー連携" style="endArrow=open;html=1;rounded=0;dashed=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="c156" target="c160"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="690"/><mxPoint x="760" y="625"/><mxPoint x="1300" y="625"/></Array></mxGeometry></mxCell><mxCell id="c175" value="&lt;b&gt;画面共通の約束事&lt;/b&gt;&lt;br&gt;・ヘッダーはシンプル（戻る）。エラー統一画面・404画面・メニュー画面は作らない（要件2.1.1）。&lt;br&gt;・入力エラーは入力欄の直下、取得失敗は領域内に「取得に失敗しました」＋再試行ボタン。&lt;br&gt;・破壊的操作（削除・退会）は警告色＋確認ダイアログ。完了はトースト。&lt;br&gt;・時刻表示はHH:mm（24時間制）。APIの日時はISO 8601（+09:00）。&lt;br&gt;・未ログイン・トークン失効時はログイン画面へ。初回（onboardingCompleted=false）はウィザードへ。&lt;br&gt;・音声入力ボタン・残り時間・延期ボタン・通知設定は表示のみ（準備のみ）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1100" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p6_176" name="05_ER図"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2339" pageHeight="1654" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c177" value="&lt;b&gt;05 ER図（DB定義書どおり）&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=22;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1200" height="36" as="geometry"/></mxCell><mxCell id="c178" value="全テーブル共通の監査カラム（created_at・updated_at・created_by_user_id・updated_by_user_id・is_deleted・deleted_at）は省略。型はDB定義書の原文（MySQL表記）。PostgreSQLへの読み替えとAPIで増えた項目はWBS 2.11で決定し、本図を更新する。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1580" height="40" as="geometry"/></mxCell><mxCell id="c179" value="user（ユーザー）" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="300" height="336" as="geometry"/></mxCell><mxCell id="c180" value="PK id INT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="c179"><mxGeometry x="0" y="28" width="300" height="22" as="geometry"/></mxCell><mxCell id="c181" value="cognito_user_id VARCHAR(255) NN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;" vertex="1" parent="c179"><mxGeometry x="0" y="50" width="300" height="22" as="geometry"/></mxCell><mxCell id="c182" value="email VARCHAR(255) NN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;" vertex="1" parent="c179"><mxGeometry x="0" y="72" width="300" height="22" as="geometry"/></mxCell><mxCell id="c183" value="home_address VARCHAR(255) NN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;" vertex="1" parent="c179"><mxGeometry x="0" y="94" width="300" height="22" as="geometry"/></mxCell><mxCell id="c184" value="home_latitude DOUBLE NN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;" vertex="1" parent="c179"><mxGeometry x="0" y="116" width="300" height="22" as="geometry"/></mxCell><mxCell id="c185" value="home_longitude DOUBLE NN" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;html=1;fontSize=11;" vertex="1" parent="c179"><mxGeometry x="0" y="138" width="300" height="22" as="geometry"/></mxCell><mxCell id="c186" value="frequently_used_stations JSON" style